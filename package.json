{
  "name": "reposizer",
  "version": "0.2.6",
  "description": "Fast CLI to inspect GitHub repository sizes",
  "license": "MIT",
  "author": "Hanif",
  "type": "module",
  "bin": {
    "reposizer": "dist/bin/reposizer.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx bin/reposizer.tsx",
    "check": "tsc --noEmit -p tsconfig.json",
    "video": "remotion studio remotion/index.js",
    "video:render": "remotion render remotion/index.js ReposizerIntro out/reposizer-intro.mp4"
  },
  "keywords": [
    "cli",
    "github",
    "repository",
    "size",
    "typescript"
  ],
  "dependencies": {
    "@remotion/cli": "^4.0.452",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cli-spinners": "^3.4.0",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "ink": "^6.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remotion": "^4.0.452",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hanif-adedotun/reposizer.git"
  },

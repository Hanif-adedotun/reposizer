{
  "name": "reposizer",
  "version": "0.1.0",
  "description": "Fast CLI to inspect GitHub repository sizes",
  "license": "MIT",
  "author": "Hanif",
  "type": "commonjs",
  "bin": {
    "reposizer": "dist/bin/reposizer.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx bin/reposizer.ts",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "cli",
    "github",
    "repository",
    "size",
    "typescript"
  ],
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hanif-adedotun/reposizer.git"
  },
  "bugs": {
    "url": "https://github.com/Hanif-adedotun/reposizer/issues"
  },
  "homepage": "https://github.com/Hanif-adedotun/reposizer#readme"
